    - target: {fileID: 6896488858904094394, guid: 28ecdaaeaceadf94397cd021b9db423c, type: 3}
      propertyPath: m_Name
      value: Tabua_de_Habilidade
      objectReference: {fileID: 0}
    - target: {fileID: 8224482125398163116, guid: 28ecdaaeaceadf94397cd021b9db423c, type: 3}
      propertyPath: text
      value: "\"Nem todo caminho est\xE1 \xE0 vista. Quem observa com calma encontra
        o que os apressados ignoram.\""
      objectReference: {fileID: 0}
    - target: {fileID: 8224482125398163116, guid: 28ecdaaeaceadf94397cd021b9db423c, type: 3}
      propertyPath: title
      value: "Inscri\xE7\xE3o: Observa\xE7\xE3o"
      objectReference: {fileID: 0}
    - target: {fileID: 8224482125398163116, guid: 28ecdaaeaceadf94397cd021b9db423c, type: 3}
      propertyPath: firstTimeTip
      value: "T\xE1buas antigas guardam dicas. Pressione [E] para ler."
      objectReference: {fileID: 0}
